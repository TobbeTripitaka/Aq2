+
+def listed_cmap(colors, n=None):
+    """Build a matplotlib ListedColormap from a list of hex colours.
+
+    If n is given, the first n colours are used (handy for K-cluster maps that
+    need exactly K entries). Kept here so every notebook builds categorical
+    colour scales the same way.
+    """
+    from matplotlib.colors import ListedColormap
+    cols = list(colors) if n is None else list(colors)[:n]
+    return ListedColormap(cols)
